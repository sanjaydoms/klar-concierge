# Klar Concierge — environment configuration
NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3002

# AI provider (optional — the deterministic engine keeps the planner fully
# usable without it)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
ENABLE_AI_PERSONALISATION=true

# Anonymous planning-session time-to-live
SESSION_TTL_MINUTES=120

# CRM/RMS handover — connected later. While disabled, the decision engine runs
# fully and the handover is truthfully unavailable (never faked).
CRM_ENABLED=false
CRM_PROVIDER=placeholder
CRM_WEBHOOK_URL=
CRM_WEBHOOK_TOKEN=
CRM_TIMEOUT_MS=8000

# Analytics provider: none | console
ANALYTICS_PROVIDER=none

# Rate limits (per-minute, per-client)
RATE_LIMIT_CHAT_PER_MINUTE=30
RATE_LIMIT_PLAN_PER_MINUTE=30
RATE_LIMIT_CRM_PER_MINUTE=5

LOG_LEVEL=info
