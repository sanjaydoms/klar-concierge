{
  "name": "klar-concierge",
  "private": true,
  "version": "2.8.0",
  "description": "Klar Concierge \u2014 conversational holiday decision engine for Klar Travels",
  "scripts": {
    "dev": "next dev -p 3002",
    "build": "npm run knowledge:build && next build",
    "start": "next start -p 3002",
    "typecheck": "tsc --noEmit",
    "lint": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "eval": "tsx tests/evaluations/run-evals.ts",
    "eval:critical": "tsx tests/evaluations/run-evals.ts --critical",
    "knowledge:generate": "tsx scripts/generate-knowledge.ts",
    "knowledge:build": "tsx scripts/knowledge-build.ts",
    "knowledge:validate": "tsx scripts/knowledge-reports.ts validate",
    "knowledge:coverage": "tsx scripts/knowledge-reports.ts coverage",
    "knowledge:staleness": "tsx scripts/knowledge-reports.ts staleness",
    "knowledge:seed": "npm run knowledge:generate && npm run knowledge:build",
    "knowledge:research": "tsx scripts/knowledge-research.ts",
    "knowledge:promote": "tsx scripts/knowledge-promote.ts",
    "knowledge:enrich": "tsx scripts/knowledge-enrich.ts",
    "knowledge:images": "tsx scripts/knowledge-images.ts",
    "knowledge:autonomous": "tsx scripts/knowledge-autonomous.ts"
  },
  "dependencies": {
    "next": "^15.5.22",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.49.0",
    "@types/node": "^22.15.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.5.25",
    "tailwindcss": "^3.4.10",
    "tsx": "^4.19.0",
    "typescript": "^5.8.0",
    "vitest": "^3.2.0",
    "world-countries": "^5.0.0"
  },
  "overrides": {
    "sharp": "^0.35.0",
    "postcss": "^8.5.25"
  }
}